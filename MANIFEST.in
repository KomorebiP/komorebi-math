include README.md LICENSE.md CHANGELOG.md CITATION.cff
include CONTRIBUTING.md REPRODUCIBILITY.md SECURITY.md
include pyproject.toml MANIFEST.in RELEASE_ID.json mkdocs.yml
include .gitattributes .gitignore
include Run_Hardware_Qualification.ps1 Run_GPU_Validation.ps1 run_gpu_validation.sh
recursive-include src/komorebi_math *.py *.json py.typed
recursive-include docs *
recursive-include examples *.py *.ps1 *.json
recursive-include tests *.py *.json
recursive-include verification *.py
include verification/installed_runtime_profile.json
include verification/release_manual_profile.json
include verification/companion_c_crosswalk.json
recursive-include constraints *.txt
recursive-include environment *.yml *.yaml
recursive-include .github/workflows *.yml *.yaml
prune development
prune release
prune qualification
prune dist
prune build
prune site
prune docs/history
prune docs/development
global-exclude __pycache__ *.py[cod] *.whl *.tar.gz *.zip *.log
